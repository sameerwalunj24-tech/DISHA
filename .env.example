# Disha Platform Environment Configuration
# Copy this file to .env and adjust values as needed.

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default, Postgres compatible)
DATABASE_URL=sqlite:///./disha.db

# AI Provider Configuration (swappable adapter: mock | openai | gemini | bhashini)
LLM_PROVIDER=mock
OPENAI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Voice Adapter Configuration (mock | bhashini | web_speech)
VOICE_ADAPTER=mock

# Security
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
